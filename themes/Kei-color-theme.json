  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5A7A8A", "fontStyle": "italic" }
    },
    {
      "name": "Comment Block Doc",
      "scope": ["comment.block.documentation"],
      "settings": { "foreground": "#A9C9E2", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "string constant.other.placeholder"],
      "settings": { "foreground": "#1E2530" }
    },
    {
      "name": "Variable Language (this, self)",
      "scope": ["variable.language"],
      "settings": { "foreground": "#F03C72", "fontStyle": "italic" }
    },
    {
      "name": "Variable Other",
      "scope": ["variable.other"],
      "settings": { "foreground": "#323842" }
    },
    {
      "name": "Variable Parameter",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#6b7590", "fontStyle": "italic" }
    },
    {
      "name": "Colors",
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#FFB6C1" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FF5370", "fontStyle": "underline" }
    },
    {
      "name": "Invalid Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#854F0B", "fontStyle": "strikethrough" }
    },
    {
      "name": "Keyword, Storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#F03C72", "fontStyle": "italic" }
    },
    {
      "name": "Keyword Control",
      "scope": ["keyword.control"],
      "settings": { "foreground": "#F03C72", "fontStyle": "italic bold" }
    },
    {
      "name": "Keyword Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#2DBBEB" }
    },
    {
      "name": "Keyword Other",
      "scope": ["keyword.other"],
      "settings": { "foreground": "#F03C72" }
    },
    {
      "name": "Operator, Misc Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": { "foreground": "#323842" }
    },
    {
      "name": "Punctuation Definition String",
      "scope": ["punctuation.definition.string"],
      "settings": { "foreground": "#0F6E56" }
    },
    {
      "name": "Punctuation Accessor (dot)",
      "scope": ["punctuation.accessor", "punctuation.separator.period"],
      "settings": { "foreground": "#2DBBEB" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag.sgml", "markup.deleted.git_gutter"],
      "settings": { "foreground": "#F03C72" }
    },
    {
      "name": "Function, Special Method",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": { "foreground": "#2DBBEB" }
    },
    {
      "name": "Function Declaration",
      "scope": ["meta.definition.method entity.name.function"],
      "settings": { "foreground": "#2DBBEB", "fontStyle": "bold" }
    },
    {
      "name": "Block Level Variables",
      "scope": ["meta.block variable.other"],
      "settings": { "foreground": "#323842" }
    },
    {
      "name": "Other Variable, String Link",
      "scope": ["support.other.variable", "string.other.link"],
      "settings": { "foreground": "#323842" }
    },
    {
      "name": "Number, Constant, Keyword Unit",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "constant.escape",
        "keyword.other.unit"
      ],
      "settings": { "foreground": "#854F0B" }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean"],
      "settings": { "foreground": "#F03C72", "fontStyle": "bold" }
    },
    {
      "name": "Null / Undefined",
      "scope": ["constant.language.null", "constant.language.undefined"],
      "settings": { "foreground": "#6b7590", "fontStyle": "italic" }
    },
    {
      "name": "String, Symbols, Inherited Class, Markup Heading",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "entity.other.inherited-class",
        "markup.heading",
        "markup.inserted.git_gutter",
        "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": { "foreground": "#0F6E56" }
    },
    {
      "name": "String Template Literal",
      "scope": ["string.template", "string.interpolated"],
      "settings": { "foreground": "#0F6E56" }
    },
    {
      "name": "String Regex",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#2DBBEB" }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#FFB6C1" }
    },
    {
      "name": "Class, Support",
      "scope": [
        "entity.name",
        "support.type",
        "support.class",
        "support.other.namespace.use.php",
        "meta.use.php",
        "support.other.namespace.php",
        "markup.changed.git_gutter",
        "support.type.sys-types"
      ],
      "settings": { "foreground": "#993C1D" }
    },
    {
      "name": "Entity Types",
      "scope": ["support.type"],
      "settings": { "foreground": "#993C1D" }
    },
    {
      "name": "CSS Property Name",
      "scope": [
